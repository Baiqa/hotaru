# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в .gitignore — секреты сюда не коммитятся.

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# Прямое подключение (db.<ref>.supabase.co) резолвится только в IPv6 — на IPv4-only
# сетях (в т.ч. эта) не работает, поэтому используем pooler (Supavisor, порт 5432).
DATABASE_URL=postgresql://postgres.uuidmsmpcnbtkmfbsmwc:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Обязателен: раздел 3.1 CLAUDE.md требует честный User-Agent с контактом.
CONTACT_EMAIL=you@example.com

# Необязательно, показаны значения по умолчанию:
# REQUEST_DELAY_SECONDS=1.5
# HTTP_TIMEOUT_SECONDS=15

# Нужен со следующей подзадачи Этапа 1 (эмбеддинги, https://aistudio.google.com/apikey).
# Позже используется и для LLM серой зоны кластеризации — один провайдер на оба случая.
GOOGLE_API_KEY=
