# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env* в .gitignore — секреты сюда не коммитятся (кроме этого шаблона).
# На Vercel те же переменные задаются в Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API. Нужны только URL и anon (publishable) ключ.
# Ключ анонимный и ограничен RLS-политиками. service_role сюда класть нельзя:
# переменные NEXT_PUBLIC_* попадают в браузер.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Страница /admin (необязательно) ---
# Без ADMIN_PASSWORD и ADMIN_DATABASE_URL все адреса /admin отвечают 404.

# Общий пароль входа, не короче 12 символов.
ADMIN_PASSWORD=

# Подключение ролью admin_reader (только SELECT), НЕ строка воркера и не service_role.
# Роль создаёт миграция 20261117120000_admin_reader_role.sql, вход включается отдельно:
#   alter role admin_reader with login password '<пароль>';
# Формат как у DATABASE_URL воркера (Session pooler), логин: admin_reader.<project-ref>
ADMIN_DATABASE_URL=

# Необязательно: секрет подписи сессии. Если пусто, используется ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=
